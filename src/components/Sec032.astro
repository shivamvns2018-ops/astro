---
// src/components/sections/DesignerSection.astro

import content from "../data/sec032.json";

const section = content.designerSection;
---

<section class="overflow-hidden bg-[#f5f5f5] py-8 lg:py-12">

  <div class="mx-auto w-[92%] max-w-[1400px]">

    <!-- TOP CONTENT -->
    <div class="mx-auto max-w-[950px] text-center">

      <!-- TAG -->
      <p
        class="text-[16px] font-semibold uppercase tracking-[3px] text-[#111827]"
      >
        {section.tag}
      </p>

      <!-- HEADING -->
      <h2
        class="mt-2 text-4xl  leading-[1.1] text-[#3b2d28] lg:text-[44px]"
      >
        {section.heading}
      </h2>

      <!-- DESCRIPTION -->
      <p
        class="mx-auto mt-3 max-w-[760px] text-[17px] leading-[1.7] text-[#4b5563] lg:text-[17px]"
      >
        {section.description}
      </p>

    </div>

    <!-- SLIDER -->
    <div
      id="designerSlider"
      class="mt-12 flex cursor-grab gap-4 overflow-x-auto scroll-smooth pb-4 scrollbar-hide active:cursor-grabbing"
    >

      {
        section.designers.map((item) => (
          <div
            class="group min-w-[250px] max-w-[250px] overflow-hidden rounded-[10px] bg-white shadow-sm transition duration-500 hover:-translate-y-1 hover:shadow-xl"
          >

            <!-- IMAGE -->
            <div class="relative overflow-hidden">

              <img
                src={item.image}
                alt={item.name}
                class="pointer-events-none h-[190px] w-full object-cover transition duration-700 group-hover:scale-105"
              />

              <!-- OVERLAY -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>

              <!-- PROFILE -->
              <div
                class="absolute -bottom-[38px] left-1/2 -translate-x-1/2"
              >

                <img
                  src={item.profile}
                  alt={item.name}
                  class="pointer-events-none h-[76px] w-[76px] rounded-full border-[4px] border-white object-cover shadow-lg"
                />

              </div>

            </div>

            <!-- CONTENT -->
            <div class="px-4 pb-5 pt-11 text-center">

              <!-- NAME -->
              <h3
                class="text-[20px] font-medium text-[#334155]"
              >
                {item.name}
              </h3>

              <!-- LOCATION -->
              <p
                class="mt-1 text-[14px] text-[#7c7c7c]"
              >
                {item.location}
              </p>

              <!-- STARS -->
              <div
                class="mt-3 flex items-center justify-center gap-1"
              >

                <span class="text-[16px] tracking-[2px] text-[#d4b64c]">
                  ★ ★ ★ ★
                </span>

                <span class="ml-1 text-[14px] text-[#8b8b8b]">
                  /{item.rating}
                </span>

              </div>

              <!-- BUTTON -->
              <a
                href={item.link}
                class="mt-4 inline-block text-[15px] font-medium text-[#4b3a32] underline underline-offset-4 transition duration-300 hover:text-black"
              >
                Learn More
              </a>

            </div>

          </div>
        ))
      }

    </div>

  </div>

</section>

<style>
  /* HIDE SCROLLBAR */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* SMOOTH DRAG */
  #designerSlider {
    user-select: none;
  }

  #designerSlider.dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }
</style>

<script>
  (function () {
    const slider = document.getElementById("designerSlider");
    if (!slider) return;

    // Duplicate content for seamless looping
    slider.innerHTML = slider.innerHTML + slider.innerHTML;

    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    let auto = true;
    const speed = 0.6; // pixels per frame, adjust to taste

    // Mouse drag
    slider.addEventListener("mousedown", (e) => {
      isDown = true;
      auto = false;
      slider.classList.add("dragging");
      startX = e.pageX - slider.offsetLeft;
      scrollLeft = slider.scrollLeft;
    });

    slider.addEventListener("mouseleave", () => {
      isDown = false;
      slider.classList.remove("dragging");
    });

    slider.addEventListener("mouseup", () => {
      isDown = false;
      slider.classList.remove("dragging");
      setTimeout(() => (auto = true), 800);
    });

    slider.addEventListener("mousemove", (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - slider.offsetLeft;
      const walk = (x - startX) * 2;
      slider.scrollLeft = scrollLeft - walk;
    });

    // Touch drag
    slider.addEventListener("touchstart", (e) => {
      auto = false;
      startX = e.touches[0].pageX - slider.offsetLeft;
      scrollLeft = slider.scrollLeft;
    });

    slider.addEventListener("touchend", () => {
      setTimeout(() => (auto = true), 800);
    });

    slider.addEventListener("touchmove", (e) => {
      const x = e.touches[0].pageX - slider.offsetLeft;
      const walk = (x - startX) * 2;
      slider.scrollLeft = scrollLeft - walk;
    });

    // Pause on hover
    slider.addEventListener("mouseenter", () => (auto = false));
    slider.addEventListener("mouseleave", () => (auto = true));

    // Auto-scroll loop
    function step() {
      if (auto) {
        slider.scrollLeft += speed;
        // When we've scrolled past the first copy, jump back by half width
        if (slider.scrollLeft >= slider.scrollWidth / 2) {
          slider.scrollLeft -= slider.scrollWidth / 2;
        }
      }
      requestAnimationFrame(step);
    }

    requestAnimationFrame(step);
  })();
</script>