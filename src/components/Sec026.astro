---
// src/components/sections/ConcreteCoatingSection.astro

import content from "../data/sec026.json";

const section = content.concreteCoating;
---

<section class="bg-[#f5f5f5] py-10 lg:py-14">
  <div
    class="mx-auto grid w-[92%] max-w-[1450px] gap-10 lg:grid-cols-2 lg:items-center"
  >

    <!-- IMAGE -->
    <div class="overflow-hidden rounded-[6px]">
      <img
        src={section.image}
        alt={section.heading}
        class="h-[320px] w-full object-cover lg:h-[420px]"
      />
    </div>

    <!-- CONTENT -->
    <div>

      <!-- HEADING -->
      <h2
        class="text-4xl font-semibold tracking-tight text-[#14213d] lg:text-4xl"
      >
        {section.heading}
      </h2>

      <!-- DESCRIPTION -->
      <div class="mt-6 space-y-5">

        <p
          class="text-[16px] leading-[1.8] text-[#1f2937]"
        >
          {section.descriptionOne}
        </p>

        <p
          class="text-[16px] leading-[1.8] text-[#1f2937]"
        >
          {section.descriptionTwo}
        </p>

        <p
          class="text-[16px] leading-[1.8] text-[#1f2937]"
        >
          {section.descriptionThree}
        </p>

        <!-- PERFECT FOR -->
        <p
          class="text-[16px] leading-[1.8] text-[#1f2937]"
        >
          <span class="font-bold text-[#111827]">
            Perfect for:
          </span>

          {section.perfectFor}
        </p>

      </div>

      <!-- BUTTON -->
      <div class="mt-8">
        <a
          href={section.button.link}
          class="inline-flex items-center gap-3 bg-[#ff5a14] px-8 py-5 text-xl font-medium text-white transition duration-300 hover:bg-[#e6490c]"
        >
          {section.button.text}

          <span class="text-2xl">
            ›
          </span>
        </a>
      </div>

    </div>

  </div>
</section>