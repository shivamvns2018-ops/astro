---
// src/components/sections/InteriorPricingSection.astro

import content from "../data/sec019.json";

const headingSection = content.interiorSection;
const tableSection = content.interiorSection;
---

<section class="bg-[#f5f5f5] py-5 lg:py-6">

  <div class="mx-auto w-[88%] max-w-[1240px]">

    <!-- ========================= -->
    <!-- HEADING -->
    <!-- ========================= -->

    <div class="text-center">

      <h2
        class="text-[30px] font-light leading-[1.1] tracking-[-1px] text-[#111827] lg:text-[48px]"
      >

        <span class="font-semibold">
          {headingSection.headingBold}
        </span>

        {headingSection.headingLight}

      </h2>

      <p
        class="mt-2 text-[16px] leading-[1.4] text-[#374151] lg:text-[16px]"
      >
        {headingSection.subheading}
      </p>

    </div>

    <!-- ========================= -->
    <!-- TABLE -->
    <!-- ========================= -->

    <div class="mx-auto mt-6 max-w-[900px] overflow-x-auto">

      <table
        class="w-full border-collapse border border-[#aeb4c0] bg-transparent"
      >

        <!-- TABLE HEAD -->
        <thead>

          <tr>

            <!-- EMPTY -->
            <th
              class="w-[34%] border border-[#aeb4c0] px-4 py-3"
            >
            </th>

            <!-- TITLE -->
            <th
              class="border border-[#aeb4c0] px-4 py-3 text-center text-[16px] font-semibold text-[#111827] lg:text-[16px]"
            >
              {tableSection.tableHeading}
            </th>

          </tr>

        </thead>

        <!-- TABLE BODY -->
        <tbody>

          {
            tableSection.rows.map((item) => (
              <tr>

                <!-- LEFT -->
                <td
                  class="border border-[#aeb4c0] px-4 py-4 align-middle text-center text-[16px] font-bold uppercase text-[#111827] lg:text-[16px]"
                >
                  {item.title}
                </td>

                <!-- RIGHT -->
                <td
                  class="border border-[#aeb4c0] px-4 py-4 text-center"
                >

                  <div class="space-y-1">

                    {
                      item.points.map((point) => (
                        <p
                          class="text-[16px] leading-[1.5] text-[#374151] lg:text-[16px]"
                        >
                          {point}
                        </p>
                      ))
                    }

                  </div>

                </td>

              </tr>
            ))
          }

        </tbody>

      </table>

    </div>

  </div>

</section>