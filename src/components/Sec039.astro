---
// src/components/sections/WhyChooseUsSection.astro

import content from "../data/sec039.json";

const section = content.whyChooseUs;
---

<section class="bg-gradient-to-b from-[#fafafa] to-[#f4f4f4] py-12 lg:py-16">

  <div class="mx-auto w-[88%] max-w-[1280px]">

    <!-- HEADER -->
    <div class="mx-auto max-w-[800px] text-center">

      <div class="flex items-center justify-center gap-3">

        <span class="h-[2px] w-8 bg-[#f97316]"></span>

        <p
          class="text-[16px] font-bold uppercase tracking-[5px] text-[#f97316]"
        >
          {section.tag}
        </p>

        <span class="h-[16px] w-8 bg-[#f97316]"></span>

      </div>

      <h2
        class="mx-auto mt-4 max-w-[820px] text-[16px]  leading-[1.5] text-[#555] lg:text-[26px]"
      >
        {section.heading}
      </h2>

    </div>

    <!-- CARDS -->
    <div
      class="mt-12 grid gap-6 lg:grid-cols-3"
    >

      {
        section.cards.map((card) => (

          <div
            class="group rounded-[24px] border border-[#e8e8e8] bg-white/80 p-8 text-center backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#f97316] hover:shadow-[0_15px_40px_rgba(249,115,22,0.12)]"
          >

            <!-- ICON -->
            <div
              class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#f97316] text-[28px] text-white transition duration-300 group-hover:scale-110 group-hover:rotate-6"
            >
              {card.icon}
            </div>

            <!-- TITLE -->
            <h3
              class="mt-6 text-[24px] font-extrabold uppercase text-[#222]"
              style="font-family: Oswald, sans-serif;"
            >
              {card.title}
            </h3>

            <!-- DESCRIPTION -->
            <p
              class="mx-auto mt-4 max-w-[280px] text-[16px] leading-[1.8] text-[#6b7280]"
            >
              {card.description}
            </p>

          </div>

        ))
      }

    </div>

  </div>

</section>