---
// src/components/sections/ModernInteriorHero.astro

import content from "../data/sec045.json";

const section = content.modernInteriorHero;
---

<section class="overflow-hidden bg-[#43352e] py-8 lg:py-12">

  <div class="mx-auto w-[92%] max-w-[1350px]">

    <!-- HERO CONTENT -->
    <div class="grid items-center gap-8 lg:grid-cols-[0.95fr_1.05fr]">

      <!-- LEFT -->
      <div>

        <!-- HEADING -->
        <h1
          class="max-w-[560px] text-[42px] font-semibold leading-[1.05] text-white lg:text-[72px]"
          style="font-family:'Cormorant Garamond', serif;"
        >
          {section.heading}
        </h1>

        <!-- DESCRIPTION -->
        <p
          class="mt-5 max-w-[540px] text-[16px] leading-[1.9] text-white/80 lg:text-[18px]"
        >
          {section.description}
        </p>

        <!-- BUTTONS -->
        <div class="mt-10 flex flex-wrap items-center gap-3">

          <a
            href={section.primaryButton.link}
            class="flex items-center gap-2 rounded-xl bg-[#d8b15a] px-8 py-3.5 font-semibold text-[#1f2d2d] transition duration-300 hover:scale-105"
          >
            {section.primaryButton.label}
            →
          </a>

          <a
            href={(section as any).secondaryButton?.link ?? '#'}
            class="flex h-12 w-12 items-center justify-center rounded-xl border border-white/20 text-white transition duration-300 hover:bg-white hover:text-[#43352e]"
          >
            ✦
          </a>

          <a
            href={(section as any).instagram?.link ?? '#'}
            class="flex h-12 w-12 items-center justify-center rounded-xl border border-white/20 text-white transition duration-300 hover:bg-white hover:text-[#43352e]"
          >
            ◎
          </a>

          <a
            href={(section as any).dribbble?.link ?? '#'}
            class="flex h-12 w-12 items-center justify-center rounded-xl border border-white/20 text-white transition duration-300 hover:bg-white hover:text-[#43352e]"
          >
            ◈
          </a>

        </div>

      </div>

      <!-- RIGHT IMAGES -->
      <div class="grid grid-cols-[1.6fr_0.55fr_0.55fr] gap-4">

        <div class="overflow-hidden rounded-[22px] shadow-2xl">
          <img
            src={section.images.main}
            alt="Interior Design"
            class="h-[400px] w-full object-cover transition duration-700 hover:scale-105 lg:h-[560px]"
          />
        </div>

        <div class="overflow-hidden rounded-[22px] shadow-2xl">
          <img
            src={section.images.lamp}
            alt="Lamp"
            class="h-[400px] w-full object-cover transition duration-700 hover:scale-105 lg:h-[560px]"
          />
        </div>

        <div class="overflow-hidden rounded-[22px] shadow-2xl">
          <img
            src={section.images.chair}
            alt="Chair"
            class="h-[400px] w-full object-cover transition duration-700 hover:scale-105 lg:h-[560px]"
          />
        </div>

      </div>

    </div>

  </div>

</section>