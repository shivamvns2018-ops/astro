---
// src/components/sections/AboutHomeDesigning.astro

import content from "../data/sec028.json";

const section = content.aboutHomeDesigning;
---

<section class="bg-[#f5f5f5] py-8 lg:py-10">
  <div
    class="mx-auto grid w-[90%] max-w-[1420px] gap-8 lg:grid-cols-[1.05fr_1fr] lg:items-center"
  >

    <!-- LEFT CONTENT -->
    <div class="max-w-[640px]">

      <!-- HEADING -->
      <h2
        class="text-4xl tracking-tight text-[#1f2937] lg:text-[55px]"
      >
        {section.heading}
      </h2>

      <!-- PARAGRAPH 1 -->
      <p
        class="mt-3 text-[19px] leading-[1.4] text-[#374151]"
      >
        {section.descriptionOne}
      </p>

      <!-- PARAGRAPH 2 -->
      <p
        class="mt-2 text-[19px] leading-[1.4] text-[#374151]"
      >
        {section.descriptionTwo.before}

        <span class="font-bold text-[#111827]">
          {section.descriptionTwo.highlightOne}
        </span>

        {section.descriptionTwo.middle}

        <span class="font-bold text-[#111827]">
          {section.descriptionTwo.highlightTwo}
        </span>

        {section.descriptionTwo.middleTwo}

        <span class="font-bold text-[#111827]">
          {section.descriptionTwo.highlightThree}
        </span>

        {section.descriptionTwo.after}
      </p>

    </div>

    <!-- RIGHT IMAGE -->
    <div class="overflow-hidden rounded-[16px]">
      <img
        src={section.image}
        alt={section.heading}
        class="h-[400px] w-160 object-cover"
      />
    </div>

  </div>
</section>