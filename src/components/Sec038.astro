---
// src/components/sections/ServiceAreasSection.astro

import content from "../data/sec038.json";

const section = (content as any).serviceAreas;
---

<section class="bg-[#cf0508] py-12 lg:py-16">

  <div class="mx-auto w-[88%] max-w-[1400px]">

    <!-- HEADER -->
    <div class="mx-auto max-w-[760px] text-center">

      <p
        class="text-[12px] font-bold uppercase tracking-[4px] text-[#ffd84d]"
      >
        {section.tag}
      </p>

      <h2
        class="mt-3 text-[34px] font-extrabold leading-tight text-white lg:text-[52px]"
      >
        {section.heading}
      </h2>

      <p
        class="mx-auto mt-4 max-w-[700px] text-[16px] leading-[1.7] text-white/85 lg:text-[18px]"
      >
        {section.description}
      </p>

    </div>

    <!-- LOCATIONS -->
    <div
      class="mt-10 grid gap-3 md:grid-cols-2 xl:grid-cols-4"
    >

      {
        section.locations.map((item: any) => (

          <a
            href={item.link}
            class="group flex items-center justify-between rounded-xl border border-white/20 bg-white/[0.03] px-5 py-4 text-white backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-[#ffd84d] hover:bg-white hover:text-[#cf0508] hover:shadow-[0_12px_30px_rgba(0,0,0,0.15)]"
          >

            <div class="flex items-center gap-3">

              <span
                class="text-[16px] text-[#ffd84d] transition group-hover:text-[#cf0508]"
              >
                📍
              </span>

              <span
                class="text-[18px] font-semibold"
              >
                {item.name}
              </span>

            </div>

            <span
              class="text-[18px] transition-all duration-300 group-hover:translate-x-1"
            >
              →
            </span>

          </a>

        ))
      }

    </div>

    <!-- BOTTOM CTA -->
    <div
      class="mt-12 rounded-2xl border border-white/15 bg-white/[0.04] px-6 py-8 text-center backdrop-blur-sm"
    >

      <p
        class="text-[18px] text-white/80"
      >
        {section.bottomText}
      </p>

      <p
        class="mt-2 text-[22px] font-bold text-[#ffd84d] lg:text-[28px]"
      >
        {section.bottomHighlight}
      </p>

    </div>

  </div>

</section>