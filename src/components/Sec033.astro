---
// src/components/sections/HowItWorksFullSection.astro

import content from "../data/sec033.json";

const section = content.howItWorksFullSection;
---

<section class="bg-[#f5f5f5] py-6 lg:py-10">

  <div class="mx-auto w-[88%] max-w-[1220px]">

    <!-- TAG -->
    <p
      class="text-center text-[16px] font-semibold uppercase tracking-[2px] text-[#2f241f]"
    >
      {section.tag}
    </p>

    <!-- ALL SECTIONS -->
    <div class="mt-8 space-y-8">

      {
        section.steps.map((item) => (

          <div
            class="grid items-center gap-6 lg:grid-cols-[0.82fr_0.95fr]"
          >

            <!-- LEFT -->
            <div
              class="grid gap-5 lg:grid-cols-[60px_1fr]"
            >

              <!-- STEP -->
              <div>
                <span
                  class="text-[40px]  leading-none text-[#2f241f]"
                >
                  {item.step}
                </span>
              </div>

              <!-- CONTENT -->
              <div>

                <!-- HEADING -->
                <h2
                  class="max-w-[500px] text-[30px] font-light leading-[1.15] text-[#2f241f] lg:text-[40px]"
                >
                  {item.heading}
                </h2>

                <!-- DESCRIPTION -->
                <p
                  class="mt-3 max-w-[500px] text-[16px] leading-[1.75] text-[#1f2937] lg:text-[16px]"
                >
                  {item.description}
                </p>

              </div>

            </div>

            <!-- RIGHT SIDE -->
            <div>

              {
                item.layout === "double" ? (

                  <div
                    class="grid h-full gap-2 lg:grid-cols-[1fr_0.85fr]"
                  >

                    <!-- LARGE IMAGE -->
                    <div class="overflow-hidden rounded-[10px]">
                      <img
                        src={item.largeImage}
                        alt={item.heading}
                        class="h-full min-h-[340px] w-full object-cover"
                      />
                    </div>

                    <!-- SMALL IMAGES -->
                    <div class="grid gap-2">

                      <div class="overflow-hidden rounded-[10px]">
                        <img
                          src={item.smallTopImage}
                          alt={item.heading}
                          class="h-[168px] w-full object-cover"
                        />
                      </div>

                      <div class="overflow-hidden rounded-[10px]">
                        <img
                          src={item.smallBottomImage}
                          alt={item.heading}
                          class="h-[168px] w-full object-cover"
                        />
                      </div>

                    </div>

                  </div>

                ) : item.layout === "split" ? (

                  <div
                    class="grid gap-1 overflow-hidden rounded-[10px] lg:grid-cols-2"
                  >

                    <!-- IMAGE 1 -->
                    <div class="overflow-hidden">
                      <img
                        src={item.leftImage}
                        alt={item.heading}
                        class="h-[340px] w-full object-cover"
                      />
                    </div>

                    <!-- IMAGE 2 -->
                    <div class="overflow-hidden">
                      <img
                        src={item.rightImage}
                        alt={item.heading}
                        class="h-[340px] w-full object-cover"
                      />
                    </div>

                  </div>

                ) : (

                  <div class="overflow-hidden rounded-[10px]">

                    <img
                      src={item.image}
                      alt={item.heading}
                      class="h-[330px] w-full object-cover"
                    />

                  </div>

                )
              }

            </div>

            <!-- CENTER BUTTON -->
            {
              item.buttonText && (
                <div class="col-span-full mt-2 flex justify-center">

                  <a
                    href={item.buttonLink}
                    class="inline-flex h-[48px] items-center justify-center rounded-full bg-[#c98c49] px-10 text-[15px] font-semibold uppercase tracking-[1px] text-white transition duration-300 hover:bg-[#b97d3c]"
                  >
                    {item.buttonText}
                  </a>

                </div>
              )
            }

          </div>

        ))
      }

    </div>

  </div>

</section>