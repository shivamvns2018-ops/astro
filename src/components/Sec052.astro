---
import data from "../data/sec052.json";

const section = data.freeDeliverablesSection;
---

<section class="relative overflow-hidden bg-[#43352e] py-10 text-white lg:py-14">

  <!-- Background Glow -->
  <div class="absolute left-0 top-0 h-52 w-52 rounded-full bg-[#b68d40]/10 blur-3xl"></div>
  <div class="absolute bottom-0 right-0 h-52 w-52 rounded-full bg-[#b68d40]/10 blur-3xl"></div>

  <div class="relative mx-auto w-[95%] max-w-[1500px]">

    <!-- Header -->
    <div class="mx-auto mb-8 max-w-5xl text-center">

      <span class="inline-flex items-center rounded-full border border-[#b68d40]/50 px-4 py-2 text-[10px] font-semibold uppercase tracking-[3px] text-[#b68d40]">
        {section.badge}
      </span>

      <h2 class="mx-auto mt-4 max-w-5xl text-2xl font-bold leading-tight md:text-4xl lg:text-5xl">
        {section.title}
      </h2>

      <p class="mx-auto mt-3 max-w-4xl text-sm leading-6 text-white/75 md:text-base">
        {section.description}
      </p>

      <div class="mt-5 inline-flex rounded-full bg-[#b68d40] px-5 py-2 text-sm font-bold text-[#2c221c] shadow-lg">
        {section.valueText}
      </div>

    </div>

    <!-- Main Content -->
    <div class="grid items-start gap-5 lg:grid-cols-[30%_70%]">

      <!-- Image -->
      <div class="relative overflow-hidden rounded-2xl">

        <img
          src={section.image}
          alt={section.title}
          loading="lazy"
          class="h-[220px] w-full object-cover md:h-[280px] lg:h-[340px]"
        />

        <!-- Overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>

        <!-- Floating Info -->
        <div class="absolute bottom-3 left-3 right-3">

          <div class="rounded-xl border border-white/10 bg-white/10 p-3 backdrop-blur-md">

            <h3 class="mb-1 text-sm font-semibold text-white">
              Free Design Package
            </h3>

            <p class="text-xs leading-5 text-white/80">
              Layouts, 3D renders, material planning, costing sheets and complete execution scope before you spend a single rupee.
            </p>

          </div>

        </div>

      </div>

      <!-- Cards -->
      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">

        {section.items.map((item) => (
          <div
            class="group rounded-xl border border-white/10 bg-white/5 p-3 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-[#b68d40] hover:bg-white/10"
          >

            <div class="mb-2 text-2xl font-bold text-[#b68d40]/30 transition duration-300 group-hover:text-[#b68d40]/60">
              {item.number}
            </div>

            <h3 class="mb-2 text-[15px] font-semibold text-white">
              {item.title}
            </h3>

            <p class="text-sm leading-5 text-white/70">
              {item.description}
            </p>

          </div>
        ))}

      </div>

    </div>

    <!-- CTA -->
    <div class="mt-8 text-center">

      <a
        href="#contact"
        class="inline-flex items-center justify-center rounded-full bg-[#b68d40] px-6 py-3 text-sm font-semibold text-[#2c221c] transition-all duration-300 hover:scale-105 hover:shadow-xl"
      >
        Claim Your Free Design Package
      </a>

      <p class="mt-3 text-xs text-white/60">
        No obligation • No hidden charges • Professional planning before you decide
      </p>

    </div>

  </div>

</section>