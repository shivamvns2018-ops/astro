---
import data from "../data/sec052.json";

const section = data.freeDeliverablesSection;
---

<section class="bg-[#43352e] py-12 lg:py-16 text-white">
  <div class="mx-auto w-[92%] max-w-[1300px]">

    <!-- Header -->
    <div class="mb-10 text-center">

      <span class="inline-block border border-[#b68d40] px-4 py-2 text-xs font-semibold uppercase tracking-[3px] text-[#b68d40]">
        {section.badge}
      </span>

      <h2 class="mx-auto mt-5 max-w-4xl text-3xl font-bold leading-tight md:text-4xl">
        {section.title}
      </h2>

      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-white/80">
        {section.description}
      </p>

      <div class="mt-6 inline-flex rounded-full bg-[#b68d40] px-6 py-3 text-base font-bold text-[#2c221c]">
        {section.valueText}
      </div>

    </div>

    <!-- Deliverables -->
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-5">

      {section.items.map((item) => (
        <div
          class="group rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-[#b68d40] hover:bg-white/10"
        >

          <!-- Number -->
          <div class="mb-3 text-4xl font-bold leading-none text-[#b68d40]/30">
            {item.number}
          </div>

          <!-- Title -->
          <h3 class="mb-3 text-lg font-semibold text-white">
            {item.title}
          </h3>

          <!-- Description -->
          <p class="text-sm leading-6 text-white/75">
            {item.description}
          </p>

        </div>
      ))}

    </div>

    <!-- CTA -->
    <div class="mt-10 text-center">
      <a
        href="#contact"
        class="inline-flex items-center rounded-full bg-[#b68d40] px-7 py-3 font-semibold text-[#2c221c] transition duration-300 hover:scale-105"
      >
        Claim Your Free Design Package
      </a>
    </div>

  </div>
</section>