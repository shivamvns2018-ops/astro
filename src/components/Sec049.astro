---
// src/components/sections/AboutAndWhyChoose.astro

import aboutData from "../data/sec049.json";
import chooseData from "../data/sec049.json";

const about = aboutData.aboutSection;
const choose = (chooseData as any).whyChooseSection;
---

<section class="overflow-hidden bg-[#efede4] py-10 lg:py-16">

  <div class="mx-auto w-[92%] max-w-[1250px]">

    <!-- ABOUT US -->
    <h2
      class="mb-8 text-center text-[52px] font-bold text-[#0a1848] lg:text-[82px]"
      style="font-family:'Cormorant Garamond', serif;"
    >
      {about.title}
    </h2>

    <div class="relative mb-20">

      <!-- IMAGE -->
      <div class="overflow-hidden rounded-sm">
        <img
          src={about.topCard.image}
          alt={about.topCard.heading}
          class="h-[320px] w-[72%] object-cover shadow-lg lg:h-[450px]"
        />
      </div>

      <!-- CARD -->
      <div
        class="absolute right-0 top-8 w-[320px] bg-white p-8 shadow-2xl lg:w-[420px] lg:p-10"
      >

        <p class="text-[11px] text-[#7b7b7b]">
          {about.topCard.subtitle}
        </p>

        <h3
          class="mt-3 text-[38px] font-bold text-[#0a1848] lg:text-[54px]"
          style="font-family:'Cormorant Garamond', serif;"
        >
          {about.topCard.heading}
        </h3>

        <p class="mt-4 text-[14px] leading-[1.9] text-[#555]">
          {about.topCard.description}
        </p>

        <p class="mt-5 text-[14px] leading-[1.9] text-[#555]">
          Lorem ipsum dolor sit amet, consectetur adipisicing elit.
          Ut est nobis, harum eos doloremque veritatis.
        </p>

        <a
          href={about.topCard.button.link}
          class="mt-8 inline-flex rounded-full bg-[#a69790] px-8 py-3 text-[14px] font-medium text-white transition hover:bg-[#8c7d76]"
        >
          {about.topCard.button.text}
        </a>

      </div>

    </div>

    <!-- WHY CHOOSE US -->
    <div class="relative">

      <!-- IMAGE -->
      <div class="ml-auto w-[78%] overflow-hidden rounded-sm">
        <img
          src={choose.image}
          alt={choose.heading}
          class="h-[320px] w-full object-cover shadow-lg lg:h-[450px]"
        />
      </div>

      <!-- CARD -->
      <div
        class="absolute left-0 top-1/2 w-[320px] -translate-y-1/2 bg-white p-8 shadow-2xl lg:w-[500px] lg:p-10"
      >

        <p class="text-[12px] font-medium text-[#777]">
          {choose.subtitle}
        </p>

        <h2
          class="mt-3 text-[38px] font-bold text-[#081b4b] lg:text-[54px]"
          style="font-family:'Cormorant Garamond', serif;"
        >
          {choose.heading}
        </h2>

        <p class="mt-4 text-[14px] leading-[1.9] text-[#555]">
          {choose.description1}
        </p>

        <p class="mt-5 text-[14px] leading-[1.9] text-[#555]">
          {choose.description2}
        </p>

        <a
          href={choose.button.link}
          class="mt-8 inline-flex rounded-full bg-[#a69790] px-8 py-3 text-[14px] font-medium text-white transition hover:bg-[#8e7d75]"
        >
          {choose.button.text}
        </a>

      </div>

    </div>

  </div>

</section>