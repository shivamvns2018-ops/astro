---
// src/components/sections/PressureWashingSection.astro

import content from "../data/sec042.json";

const section = content.pressureWashing;
---

<section class="relative overflow-hidden bg-[#f7f7f7] py-10 lg:py-14">

  <!-- Bottom Shape -->
  <div
    class="absolute bottom-0 left-0 h-[70px] w-full bg-[#6fb2e7]"
    style="clip-path: polygon(0 100%, 100% 0, 100% 100%);"
  ></div>

  <div
    class="relative z-10 mx-auto grid w-[90%] max-w-[1200px] items-center gap-8 lg:grid-cols-[1fr_0.8fr]"
  >

    <!-- LEFT CONTENT -->
    <div>

      <!-- Heading -->
      <h2
        class="text-[34px] font-black uppercase leading-[1.05] text-black lg:text-[58px]"
        style="font-family: Oswald, sans-serif;"
      >
        {section.headingLine1}
      </h2>

      <h3
        class="mt-1 text-[32px] font-black uppercase leading-[1.05] text-[#f5a623] lg:text-[54px]"
        style="font-family: Oswald, sans-serif;"
      >
        {section.headingLine2}
      </h3>

      <!-- Text -->
      <div
        class="mt-6 max-w-[650px] space-y-5 text-[16px] leading-[1.8] text-[#222]"
      >

        <p>
          {section.description1}
          <strong class="font-bold text-black">
            {" "}
            {section.highlight1}
          </strong>
        </p>

        <p>
          {section.description2}
          <strong class="font-bold text-black">
            {" "}
            {section.highlight2}
          </strong>
          {" "}
          {section.description3}
        </p>

      </div>

      <!-- Buttons -->
      <div class="mt-8 flex flex-wrap gap-4">

        <a
          href={section.primaryButtonLink}
          class="flex min-w-[260px] items-center justify-center rounded-md border-2 border-[#f5a623] bg-[#f5a623] px-6 py-3 text-center text-[18px] font-black uppercase text-white transition duration-300 hover:bg-[#df941d]"
          style="font-family: Oswald, sans-serif;"
        >
          {section.primaryButtonText}
        </a>

        <a
          href={section.phoneLink}
          class="flex min-w-[260px] items-center justify-center rounded-md border-2 border-[#1f73c9] bg-white px-6 py-3 text-center text-[18px] font-black text-[#1f73c9] transition duration-300 hover:bg-[#1f73c9] hover:text-white"
          style="font-family: Oswald, sans-serif;"
        >
          {section.phoneNumber}
        </a>

      </div>

    </div>

    <!-- RIGHT IMAGE -->
    <div class="flex justify-center lg:justify-end">

      <div class="relative">

        <!-- Orange Glow -->
        <div
          class="absolute -right-4 -top-4 h-[120px] w-[120px] rounded-full bg-[#f5a623]/20 blur-3xl"
        ></div>

        <!-- Blue Glow -->
        <div
          class="absolute -left-6 -bottom-6 h-[150px] w-[150px] rounded-full bg-[#1f73c9]/15 blur-3xl"
        ></div>

        <!-- Back Card -->
        <div
          class="absolute left-[-25px] top-[25px] h-[390px] w-[260px] rotate-[-8deg] rounded-[24px] bg-white shadow-xl"
        ></div>

        <!-- Front Image -->
        <div
          class="group relative z-10 overflow-hidden rounded-[24px] shadow-[0_20px_50px_rgba(0,0,0,0.15)] transition duration-500"
          style="clip-path: polygon(10% 0%, 100% 0%, 90% 100%, 0% 92%);"
        >

          <img
            src={section.image}
            alt={section.headingLine2}
            class="h-[450px] w-[340px] object-cover transition duration-700 group-hover:scale-110"
          />

          <!-- Overlay -->
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent"
          ></div>

          <!-- Floating Badge -->
          <div
            class="absolute bottom-4 left-4 rounded-xl bg-white/95 px-4 py-2 shadow-lg backdrop-blur"
          >
            <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">
              Trusted Experts
            </p>

            <h4 class="text-[18px] font-black text-[#1f2937]">
              100% Satisfaction
            </h4>
          </div>

        </div>

      </div>

    </div>

  </div>

</section>