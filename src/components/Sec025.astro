---
// src/components/sections/WhatWeDoSection.astro

import content from "../data/sec025.json";

const section = content.whatWeDo;
---

<section class="bg-[#f5f5f5] py-8 lg:py-10">
  <div class="mx-auto grid w-[90%] max-w-[1320px] gap-8 lg:grid-cols-2 lg:items-center">

    <!-- IMAGE -->
    <div class="overflow-hidden rounded-[8px]">
      <img
        src={section.image}
        alt={section.heading}
        class="h-[320px] w-full object-cover lg:h-[360px]"
      />
    </div>

    <!-- CONTENT -->
    <div>

      <!-- HEADING -->
      <h2
        class="text-4xl font-extrabold uppercase tracking-[2px] text-[#111111] lg:text-4xl"
      >
        {section.heading}
      </h2>

      <!-- DESCRIPTION -->
      <div class="mt-5 space-y-4">
        {
          section.description.map((text) => (
            <p
              class="text-[16px] leading-[1.9] text-[#6b7280]"
            >
              {text}
            </p>
          ))
        }
      </div>

    </div>

  </div>
</section>