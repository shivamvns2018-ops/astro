---
// src/components/sections/StatsSection.astro

import content from "../data/sec040.json";

const section = content.statsSection;
---

<section
  class="relative overflow-hidden py-8 lg:py-12"
  style={`background:${section.backgroundColor}`}
>

  <!-- Background Glow -->
  <div class="absolute inset-0">
    <div class="absolute left-0 top-0 h-64 w-64 rounded-full bg-white/10 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 h-64 w-64 rounded-full bg-white/10 blur-3xl"></div>
  </div>

  <div class="relative mx-auto w-[92%] max-w-[1450px]">

    <div
      class="grid gap-4 md:grid-cols-2 lg:grid-cols-4"
    >

      {
        section.stats.map((item) => (

          <div
            class="group rounded-3xl border border-white/15 bg-white/5 px-6 py-8 text-center backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:bg-white/10 hover:shadow-[0_15px_40px_rgba(255,255,255,0.12)]"
          >

            <!-- NUMBER -->
            <h2
              class="text-[52px] font-black leading-none text-white transition duration-300 group-hover:scale-105 lg:text-[82px]"
              style="font-family: Oswald, sans-serif;"
            >
              {item.number}
              <span>{item.suffix}</span>
            </h2>

            <!-- Divider -->
            <div
              class="mx-auto mt-4 h-[2px] w-12 bg-white/30 transition-all duration-300 group-hover:w-20"
            ></div>

            <!-- LABEL -->
            <p
              class="mt-4 text-[11px] font-semibold uppercase tracking-[4px] text-white/90 lg:text-[13px]"
            >
              {item.label}
            </p>

          </div>

        ))
      }

    </div>

  </div>

</section>