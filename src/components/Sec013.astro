---
// src/components/sections/InteriorHeroSection.astro

import content from "../data/sec013.json";

const section = content.interiorHero;
---

<section
  class="relative overflow-hidden"
  aria-labelledby="interior-hero-heading"
>

  <!-- HERO -->
  <div class="relative min-h-[88vh] w-full lg:min-h-[92vh]">

    <!-- BACKGROUND IMAGE -->
    <img
      src={section.image}
      alt={section.imageAlt}
      width="1800"
      height="1200"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
    />

    <!-- DARK OVERLAY -->
    <div class="absolute inset-0 bg-black/60"></div>

    <!-- CONTENT -->
    <div
      class="relative z-20 flex min-h-[88vh] items-center justify-center px-6 py-20 text-center sm:px-10 lg:min-h-[92vh] lg:px-16"
    >
      <div class="max-w-[1200px]">

        <!-- HEADING -->
        <h1
          id="interior-hero-heading"
          class="text-4xl font-medium leading-[1.2] tracking-[-2px] text-white sm:text-5xl lg:text-7xl"
        >
          {section.heading}
        </h1>

        <!-- DESCRIPTION -->
        <p
          class="mx-auto mt-8 max-w-[950px] text-[18px] leading-[1.9] text-white/90 sm:text-[20px] lg:text-[24px]"
        >
          {section.description}
        </p>

        <!-- BUTTON -->
        <div class="mt-12">
          <a
            href={section.button.link}
            class="inline-flex min-h-[58px] items-center justify-center rounded-md bg-[#f4a300] px-10 text-[18px] font-medium text-white transition duration-300 hover:bg-[#db9200]"
          >
            {section.button.label}
          </a>
        </div>

      </div>
    </div>

  </div>

</section>